<?xml version="1.0" encoding="UTF-8"?>
<!-- Example LOGBACK Configuration File http://logback.qos.ch/manual/configuration.html -->
<configuration scan="true" scanPeriod="30 seconds">
	<springProperty scope="context" name="appName" source="spring.application.name"/>
	<!-- online -->
	<springProfile name="test,online">
		<appender name="stdout" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<file>${LOGS_DIR}/stdout.log</file>
			<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
				<fileNamePattern>${LOGS_DIR}/otherdays/stdout.log.%d{yyyy-MM-dd}</fileNamePattern>
				<maxHistory>10</maxHistory>
			</rollingPolicy>
			<encoder>
				<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} {%thread} %-5level %logger{50}-%L - %msg%n</pattern>
			</encoder>
		</appender>
		<appender name="asyncStdout" class="ch.qos.logback.classic.AsyncAppender">
			<queueSize>2048</queueSize>
			<neverBlock>true</neverBlock>
			<appender-ref ref="stdout"/>
		</appender>
		<appender name="accessLogAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
			<file>${LOGS_DIR}/access.log</file>
			<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
				<fileNamePattern>${LOGS_DIR}/otherdays/access.log.%d{yyyy-MM-dd}</fileNamePattern>
				<maxHistory>10</maxHistory>
			</rollingPolicy>
			<encoder>
				<pattern>%msg%n</pattern>
			</encoder>
		</appender>
		<appender name="asyncAccessLogAppender" class="ch.qos.logback.classic.AsyncAppender">
			<queueSize>2048</queueSize>
			<neverBlock>true</neverBlock>
			<appender-ref ref="accessLogAppender"/>
		</appender>
		<logger name="accessLog" level="INFO" additivity="false">
			<appender-ref ref="asyncAccessLogAppender"/>
		</logger>
		<logger name="com.netflix.util.concurrent.ShutdownEnabledTimer" level="warn" additivity="false">
			<appender-ref ref="asyncStdout"/>
		</logger>
		<logger name="com.sohu.tv.index.cloud.metrics" level="warn" additivity="false">
			<appender-ref ref="asyncStdout"/>
		</logger>
		<root level="INFO">
			<appender-ref ref="asyncStdout"/>
		</root>
	</springProfile>

	<!-- local -->
	<springProfile name="local">
		<appender name="stdout" class="ch.qos.logback.core.ConsoleAppender">
			<encoder>
				<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} {%thread} %-5level %logger{50}-%L - %msg%n</pattern>
			</encoder>
		</appender>
	    <logger name="com.netflix.util.concurrent.ShutdownEnabledTimer" level="warn" additivity="false">
	        <appender-ref ref="stdout" />
	    </logger>
		<root level="INFO">
			<appender-ref ref="stdout" />
		</root>
	</springProfile>
</configuration>